@model IEnumerable<Project_Photo.Models.PhotographerService>

@{
    ViewData["Title"] = "Index";
}

<h1>攝影師可提供的服務</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ServiceName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BasePrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Duration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxRevisions)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeliveryDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IncludedPhotos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdditionalServices)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Photographer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ServiceType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ServiceName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BasePrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Duration)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxRevisions)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeliveryDays)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IncludedPhotos)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdditionalServices)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Photographer.StudioName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ServiceType.ServiceName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PhotographerServiceId">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.PhotographerServiceId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
