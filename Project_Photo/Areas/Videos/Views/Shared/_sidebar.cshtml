<div class="sidebar" id="videoSidebar">
	<div class="sidebar-header">
		<div class="logo">
			<i class="fas fa-video"></i>
		</div>
		<span class="logo-text">影片管理</span>
	</div>

	<button class="toggle-btn" id="sidebarToggleBtn">
		<i class="fas fa-chevron-left"></i>
	</button>

	<ul class="menu">
		<li class="menu-item">
			<a href="@Url.Action("Index", "Videos", new { area = "Videos" })"
			   class="menu-link"
			   data-controller="Videos"
			   data-action="Index">
				<i class="fas fa-list menu-icon"></i>
				<span class="menu-text">影片列表</span>
			</a>
		</li>
		<li class="menu-item">
			<a href="@Url.Action("Index", "Channel", new { area = "Videos" })"
			   class="menu-link"
			   data-controller="Channel"
			   data-action="Index">
				<i class="fas fa-list menu-icon"></i>
				<span class="menu-text">頻道列表</span>
			</a>
		</li>
		<li class="menu-item">
			<a href="@Url.Action("Create", "Videos", new { area = "Videos" })"
			   class="menu-link"
			   data-controller="Videos"
			   data-action="Create">
				<i class="fas fa-plus-circle menu-icon"></i>
				<span class="menu-text">新增影片</span>
			</a>
		</li>
		
	</ul>
</div>

<style>
	/* 重置樣式，避免與外層 Layout 衝突 */
	.sidebar, .sidebar * {
		box-sizing: border-box;
	}

	body {
		font-family: 'Microsoft JhengHei', Arial, sans-serif;
		margin: 0;
		padding: 0;
	}

	.sidebar {
		position: fixed;
		left: 0;
		top: -2vh; /* 假設 Navbar 高度為 60px */
		height: 102vh; /* 調整高度，填滿剩餘視窗空間 */
		width: 250px;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		padding: 20px 0;
		transition: width 0.3s ease;
		overflow-x: hidden;
		overflow-y: auto;
		box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
		z-index: 1000;
	}

		.sidebar.collapsed {
			width: 80px;
		}

	.sidebar-header {
		display: flex;
		align-items: center;
		padding: 0 20px;
		margin-bottom: 30px;
		height: 60px;
	}

	.logo {
		width: 40px;
		height: 40px;
		background: white;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #667eea;
		font-size: 20px;
		flex-shrink: 0;
	}

	.logo-text {
		margin-left: 15px;
		color: white;
		font-size: 20px;
		font-weight: bold;
		white-space: nowrap;
		opacity: 1;
		transition: opacity 0.3s ease;
	}

	.sidebar.collapsed .logo-text {
		opacity: 0;
		pointer-events: none;
	}

	.toggle-btn {
		position: absolute;
		right: 5px;
		top: 70px;
		width: 30px;
		height: -30px;
		background: white;
		border: none;
		border-radius: 50%;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
		transition: transform 0.3s ease;
		z-index: 1001;
	}

		.toggle-btn:hover {
			transform: scale(1.1);
		}

		.toggle-btn:focus {
			outline: none;
		}

		.toggle-btn i {
			color: #667eea;
			transition: transform 0.3s ease;
		}

	.sidebar.collapsed .toggle-btn i {
		transform: rotate(180deg);
	}

	.menu {
		list-style: none;
		padding: 0 10px;
		margin: 0;
	}

	.menu-item {
		margin-bottom: 5px;
	}

	.menu-link {
		display: flex;
		align-items: center;
		padding: 15px 15px;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		border-radius: 10px;
		transition: all 0.3s ease;
		position: relative;
		overflow: hidden;
	}

		.menu-link:hover {
			background: rgba(255, 255, 255, 0.1);
			color: white;
			transform: translateX(5px);
		}

		.menu-link.active {
			background: rgba(255, 255, 255, 0.2);
			color: white;
			font-weight: 600;
		}

			.menu-link.active::before {
				content: '';
				position: absolute;
				left: 0;
				top: 50%;
				transform: translateY(-50%);
				width: 4px;
				height: 24px;
				background: white;
				border-radius: 0 4px 4px 0;
			}

	.menu-icon {
		font-size: 20px;
		width: 40px;
		text-align: center;
		flex-shrink: 0;
	}

	.menu-text {
		margin-left: 10px;
		white-space: nowrap;
		opacity: 1;
		transition: opacity 0.3s ease;
	}

	.sidebar.collapsed .menu-text {
		opacity: 0;
		pointer-events: none;
	}

	.main-content {
		margin-left: 0px;
		padding: 30px;
		transition: margin-left 0.3s ease;
		min-height: 100vh;
		background: #f0f2f5;
	}

	.sidebar.collapsed ~ .main-content {
		margin-left: 0px;
	}

	/* 滾動條樣式 */
	.sidebar::-webkit-scrollbar {
		width: 6px;
	}

	.sidebar::-webkit-scrollbar-track {
		background: rgba(255, 255, 255, 0.1);
	}

	.sidebar::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.3);
		border-radius: 3px;
	}

		.sidebar::-webkit-scrollbar-thumb:hover {
			background: rgba(255, 255, 255, 0.5);
		}

	/* 響應式設計 */
	@@media (max-width: 768px) {
		.sidebar

	{
		width: 80px;
	}

	.sidebar.collapsed {
		width: 0;
		padding: 0;
	}

	.main-content {
		margin-left: 80px;
	}

	.sidebar.collapsed ~ .main-content {
		margin-left: 0;
	}

	.toggle-btn {
		right: -12px;
	}

	}
</style>

<script>
	(function() {
		'use strict';

		document.addEventListener('DOMContentLoaded', function() {
			const sidebar = document.getElementById('videoSidebar');
			const toggleBtn = document.getElementById('sidebarToggleBtn');
			const menuLinks = document.querySelectorAll('.menu-link');
			const storageKey = 'videosSidebarCollapsed';

			if (!sidebar || !toggleBtn) return;

			// 側邊欄收合/展開功能
			toggleBtn.addEventListener('click', function() {
				sidebar.classList.toggle('collapsed');
				const isCollapsed = sidebar.classList.contains('collapsed');

				try {
					localStorage.setItem(storageKey, isCollapsed);
				} catch (e) {
					console.warn('無法儲存側邊欄狀態:', e);
				}
			});

			// 恢復側邊欄狀態
			try {
				const isCollapsed = localStorage.getItem(storageKey) === 'true';
				if (isCollapsed) {
					sidebar.classList.add('collapsed');
				}
			} catch (e) {
				console.warn('無法讀取側邊欄狀態:', e);
			}

			// 設定當前頁面的選單項目為 active 狀態
			// 方法1: 從 ViewBag 或 ViewData 取得當前 Action

			// 從路由資料取得當前的 Controller 和 Action
			const currentController = '@ViewContext.RouteData.Values["controller"]';
			const currentAction = '@ViewContext.RouteData.Values["action"]';

			menuLinks.forEach(function(link) {
				// 連結的 Controller 和 Action 資訊可以從 href 或額外的 data 屬性取得
				// 為了方便，我們從 data-action 取得 'Action'，並從 `data-controller` 取得 Controller
				// 但是您目前沒有 `data-controller`，所以我們需要一個更具體的唯一識別符

				// ***改為在 Razor 程式碼中輸出一個完整的唯一識別符 (例如: 'Videos/Index')***
				const linkController = link.getAttribute('data-controller');
				const linkAction = link.getAttribute('data-action'); // 這裡仍是 'Index' 或 'Create'

				// 移除所有 active
				link.classList.remove('active');

				// 建立一個連結的唯一識別符 (例如: 'videos/index' 或 'channel/index')
				const linkIdentifier = (linkController + '/' + linkAction).toLowerCase();
				const currentIdentifier = (currentController + '/' + currentAction).toLowerCase();

				// 檢查是否匹配
				if (linkIdentifier === currentIdentifier) {
					link.classList.add('active');
				}
			});

			// 點擊選單項目時的動畫效果
			menuLinks.forEach(function(link) {
				link.addEventListener('click', function() {
					menuLinks.forEach(function(l) {
						l.classList.remove('active');
					});
					this.classList.add('active');
				});
			});

			// ESC 鍵收合側邊欄
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape' && !sidebar.classList.contains('collapsed')) {
					sidebar.classList.add('collapsed');
					try {
						localStorage.setItem(storageKey, 'true');
					} catch (ex) {}
				}
			});
		});
	})();
</script>
