@model Project_Photo.Areas.Videos.Models.ViewModels.ChannelViewModel
@{
	ViewData["Title"] = @Model.Channel.ChannelName + " 頻道細節";
}

<h1>頻道詳細資訊</h1>

<div class="channel-detail-container">
	<div class="channel-header">
		@* 頻道封面圖/頭像 *@@* 
		@if (!string.IsNullOrEmpty(Model.Channel.BannerUrl))
		{
			<img src="@Model.Channel.BannerUrl" alt="頻道封面" class="channel-banner mb-3" style="max-width: 100%; height: auto;" />
		} *@

		<div class="channel-info">
			<h4>頻道資訊</h4>
			<hr />
			<dl class="row">
				<dt class="col-sm-3">
					頻道 ID
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.Channel.ChannelId)
				</dd>

				<dt class="col-sm-3">
					頻道名稱
				</dt>
				<dd class="col-sm-9">
					<strong>@Html.DisplayFor(model => model.Channel.ChannelName)</strong>
				</dd>

				<dt class="col-sm-3">
					頻道擁有者
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.User.Account)
				</dd>

				<dt class="col-sm-3">
					頻道簡介
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.Channel.Description)
				</dd>

				<dt class="col-sm-3">
					訂閱者數量
				</dt>
				<dd class="col-sm-9">
					<strong>@Model.FollowerCount</strong> 位訂閱者
				</dd>

				<dt class="col-sm-3">
					影片總數
				</dt>
				<dd class="col-sm-9">
					<strong>@Model.VideoCount</strong> 部影片
				</dd>

				<dt class="col-sm-3">
					建立日期
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.Channel.CreatedAt)
				</dd>

				<dt class="col-sm-3">
					最後更新
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.Channel.UpdateAt)
				</dd>
			</dl>

			@* 追蹤按鈕 *@
			<div class="mt-3">
				<button class="btn btn-primary" id="subscribeBtn">
					<i class="bi bi-bell"></i> 訂閱
				</button>
				<a asp-action="Index" asp-controller="Channel" class="btn btn-secondary">
					返回頻道列表
				</a>
			</div>
		</div>
	</div>

	<hr class="my-4" />

	@* 頻道影片列表區塊 *@
	<h2>🎥 頻道影片列表</h2>
	@if (Model.Videos != null && Model.Videos.Any())
	{
		<div class="table-responsive">
			<table class="table table-striped table-hover">
				<thead class="table-dark">
					<tr>
						<th>影片 ID</th>
						<th>縮圖</th>
						<th>標題</th>
						<th>描述</th>
						<th>長度</th>
						<th>解析度</th>
						<th>檔案大小</th>
						<th>處理狀態</th>
						<th>隱私狀態</th>
						<th>上傳日期</th>
						<th>最後更新</th>
						<th>操作</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var video in Model.Videos)
					{
						<tr>
							<td>@video.VideoId</td>
							<td>
								@if (!string.IsNullOrEmpty(video.ThumbnailUrl))
								{
									<img src="@video.ThumbnailUrl" alt="縮圖" style="max-width: 100px; height: auto;" />
								}
								else
								{
									<span class="text-muted">無縮圖</span>
								}
							</td>
							<td>
								<strong>@video.Title</strong>
							</td>
							<td>
								@if (!string.IsNullOrEmpty(video.Description))
								{
									@(video.Description.Length > 50 ? video.Description.Substring(0, 50) + "..." : video.Description)
								}
								else
								{
									<span class="text-muted">無描述</span>
								}
							</td>
							<td>@video.Duration 秒</td>
							<td>@video.Resolution</td>
							<td>@((video.FileSize / 1024.0 / 1024.0).ToString()) MB</td>
							<td>
								<span class="badge bg-info">@video.ProcessStatus</span>
							</td>
							<td>
								<span class="badge bg-secondary">@video.PrivacyStatus</span>
							</td>
							<td>@video.CreatedAt.ToShortDateString()</td>
							<td>@video.UpdateAt.ToShortDateString()</td>
							<td>
								<div class="btn-group" role="group">
									<a asp-action="Watch" asp-controller="Video" asp-route-id="@video.VideoId" class="btn btn-sm btn-primary" title="觀看">
										<i class="bi bi-play-circle"></i>
									</a>
									<a asp-action="Edit" asp-controller="Video" asp-route-id="@video.VideoId" class="btn btn-sm btn-warning" title="編輯">
										<i class="bi bi-pencil"></i>
									</a>
									<a asp-action="Delete" asp-controller="Video" asp-route-id="@video.VideoId" class="btn btn-sm btn-danger" title="刪除">
										<i class="bi bi-trash"></i>
									</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		@* 統計資訊摘要 *@
		<div class="alert alert-light mt-3" role="alert">
			<strong>📊 統計資訊：</strong>
			總共 <strong>@Model.Videos.Count()</strong> 部影片
		</div>
	}
	else
	{
		<div class="alert alert-info" role="alert">
			<i class="bi bi-info-circle"></i> 此頻道尚未上傳任何影片。
		</div>
	}
</div>

@section Scripts {
	<script>
		// 訂閱按鈕功能（示例）
		document.getElementById('subscribeBtn').addEventListener('click', function() {
			// 這裡可以添加 AJAX 請求來處理訂閱/取消訂閱
			alert('訂閱功能需要實作後端 API');
		});
	</script>
}
