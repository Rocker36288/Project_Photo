
@model IEnumerable<Project_Photo.Areas.Videos.Models.Channel>
@{
	ViewData["Title"] = "頻道管理列表";
}

<div class="container mt-5">
	<h2><i class="fas fa-list-alt"></i> 頻道管理列表</h2>
	<hr />

	<div class="mb-3">
		<button id="initializeBtn" class="btn btn-success">
			<i class="fas fa-magic"></i> 批量初始化未創建的頻道
		</button>
		<span id="initializationMessage" class="ms-3 text-info"></span>
	</div>

	@if (Model == null || !Model.Any())
	{
		<div class="alert alert-warning" role="alert">
			目前沒有任何頻道資料。請點擊上方按鈕進行初始化。
		</div>
	}
	else
	{
		<table class="table table-striped table-hover">
			<thead>
				<tr>
					<th>
						@Html.DisplayNameFor(model => model.ChannelId)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.ChannelName)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Description)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.CreatedAt)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.UpdateAt)
					</th>
					<th>操作</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>
							@Html.DisplayFor(modelItem => item.ChannelId)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.ChannelName)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.Description)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.CreatedAt)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.UpdateAt)
						</td>
						<td>
							<a asp-action="Detail" asp-route-id="@item.ChannelId" class="btn btn-sm btn-outline-info me-1" title="查看詳情">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-xs"><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
							</a>
							<a asp-action="Edit" asp-route-id="@item.ChannelId" class="btn btn-sm btn-warning">編輯</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>

@section Scripts {
	<script>
		document.getElementById('initializeBtn').addEventListener('click', async () => {
			const messageElement = document.getElementById('initializationMessage');
			messageElement.textContent = '正在初始化，請稍候...';

			// 💡 呼叫後台的初始化 Action
			const response = await fetch('/Videos/Channel/InitializeChannels', {
				method: 'POST',
				// 確保發送 Anti-Forgery Token
				headers: {
					'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
				}
			});

			if (response.ok) {
				const result = await response.json();

				// ✨ 關鍵修復：將 Success, Message, Count 改為小寫的 success, message, count ✨
				if (result.success) { // <-- 已修正為小寫 'success'
					messageElement.textContent = `${result.message} (共建立 ${result.count} 筆)`; // <-- 已修正為小寫 'message' 和 'count'
					// 初始化完成後，重新整理頁面以顯示新資料
					setTimeout(() => {
						window.location.reload();
					}, 2000);
				} else {
					messageElement.textContent = `初始化失敗: ${result.message}`; // <-- 已修正為小寫 'message'
				}
			} else {
				messageElement.textContent = '初始化請求失敗，請檢查伺服器日誌。';
			}
		});
	</script>
}
