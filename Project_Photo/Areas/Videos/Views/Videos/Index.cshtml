@model Project_Photo.Areas.Videos.Models.ViewModels.VideoListViewModel

@{
    ViewBag.Title = "影片列表";
}

@section Styles{
<style>
    /* 保持原有的漸入動畫，讓影片列表載入更平滑 */
    .video-item {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.5s ease forwards;
    }
    
    @@keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .video-item:nth-child(1) { animation-delay: 0.05s; }
    .video-item:nth-child(2) { animation-delay: 0.1s; }
    .video-item:nth-child(3) { animation-delay: 0.15s; }
    .video-item:nth-child(4) { animation-delay: 0.2s; }
    .video-item:nth-child(5) { animation-delay: 0.25s; }
    /* 後續項目的動畫延遲可以透過 JS 動態生成，這裡先寫死前五個 */

    /* 調整影片項目行高和間距 */
    .video-list-item {
        padding: 0.75rem 1.25rem;
    }

    .video-thumbnail {
        width: 100px;
        height: 56px;
        flex-shrink: 0;
        border-radius: var(--tblr-border-radius); /* 使用 Tabler 變數 */
        overflow: hidden;
    }

.badge.bg-success-lt {
        background-color: var(--tblr-success-bg-subtle, #d2f4d3) !important;
    }

    .badge.bg-info-lt {
        background-color: var(--tblr-info-bg-subtle, #d7f4fc) !important;
    }

    .badge.bg-azure-lt {
        background-color: var(--tblr-azure-bg-subtle, #d6eaff) !important;
    }
	/* 確保徽章內的文字是深色的，以防父元素影響 */
    .badge.bg-success-lt, .badge.bg-info-lt, .badge.bg-azure-lt {
        color: var(--tblr-body-color, #212529) !important;
    }
</style>
}

<div class="container-xl">
    <div class="page-header d-print-none">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-movie me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" /><path d="M8 4l0 16" /><path d="M16 4l0 16" /><path d="M4 8l16 0" /><path d="M4 16l16 0" /></svg>
                    影片後台管理系統
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <a asp-action="Create" class="btn btn-primary d-none d-sm-inline-block">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                    上傳新影片
                </a>
            </div>
        </div>
    </div>

    <div class="row row-cards">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">搜尋與篩選</h3>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Index" id="searchForm">
                        <div class="row g-3">
                            <div class="col-md-5 col-lg-4">
                                <label class="form-label">搜尋關鍵字</label>
                                <div class="input-icon">
                                    <input type="text" name="searchTerm" id="searchTerm" class="form-control" placeholder="輸入搜尋內容..." value="@Model.SearchTerm">
                                    <span class="input-icon-addon">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label">搜尋類型</label>
                                <select name="searchBy" id="searchBy" class="form-select">
                                    <option value="title" selected="@(Model.SearchBy == "title")">影片標題</option>
                                    <option value="username" selected="@(Model.SearchBy == "username")">發布者</option>
                                    <option value="date" selected="@(Model.SearchBy == "date")">上傳日期</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-lg-2">
                                <label class="form-label">排序依據</label>
                                <select name="sortBy" id="sortBy" class="form-select">
                                    <option value="date" selected="@(Model.SortBy == "date")">日期</option>
                                    <option value="views" selected="@(Model.SortBy == "views")">觀看次數</option>
                                    <option value="likes" selected="@(Model.SortBy == "likes")">按讚數</option>
                                    <option value="comments" selected="@(Model.SortBy == "comments")">留言數</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-lg-2">
                                <label class="form-label">排序方式</label>
                                <select name="sortOrder" id="sortOrder" class="form-select">
                                    <option value="desc" selected="@(Model.SortOrder == "desc")">降序</option>
                                    <option value="asc" selected="@(Model.SortOrder == "asc")">升序</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-lg-2 d-flex align-items-end">
                                <div class="w-100 d-flex align-items-center justify-content-start" style="height: 38px;">
                                    <div class="spinner-border spinner-border-sm text-primary d-none" id="loadingSpinner" role="status">
                                        <span class="visually-hidden">載入中...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    @if (Model.TotalItems > 0)
    {
        <div class="alert alert-info mt-3">
            <div class="d-flex align-items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-info-circle me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 9h.01" /><path d="M11 12h1v4h1" /></svg>
                找到 <strong>@Model.TotalItems</strong> 個影片，目前顯示第 <strong>@Model.CurrentPage</strong> 頁，共 <strong>@Model.TotalPages</strong> 頁
            </div>
        </div>
    }

    <div class="card mt-3">
        <div class="list-group list-group-flush" id="videoList">
            @if (Model.Videos.Any())
            {
                @foreach (var item in Model.Videos)
                {
                    <div class="list-group-item video-list-item video-item">
                        <div class="d-flex align-items-center">
                            
                            <div class="video-thumbnail me-3 position-relative">
                                <a asp-action="Details" asp-route-id="@item.Video.VideoId">
                                    <img class="w-100 h-100 object-cover" src="@Html.DisplayFor(modelItem => item.Video.ThumbnailUrl)" alt="影片縮圖" style="object-fit: cover;" />
                                </a>
                                <span class="badge position-absolute bottom-0 end-0 m-1 bg-dark text-white opacity-75 fw-normal">
                                    @(TimeSpan.FromSeconds(Convert.ToDouble(item.Video.Duration)).ToString(@"m\:ss"))
                                </span>
                            </div>

                            <div class="flex-grow-1 me-3">
                                <h4 class="h5 card-title mb-1 text-truncate">
                                    <a asp-action="Details" asp-route-id="@item.Video.VideoId" class="text-reset">@Html.DisplayFor(modelItem => item.Video.Title)</a>
                                </h4>

                                <div class="text-secondary small d-flex flex-wrap align-items-center">
                                    <span class="avatar avatar-xs me-1" style="background-image: url(/static/avatars/023m.jpg)"></span>
                                    <span class="me-3">@item.Video.Channel.ChannelName</span> 
                                    
                                    <span class="me-3 d-flex align-items-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-xs me-1 text-muted" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M12 7v5l3 3" /></svg>
                                        @Html.DisplayFor(modelItem => item.Video.CreatedAt)
                                    </span>

                                    <span class="me-3 d-flex align-items-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-xs me-1 text-muted" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" /><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" /></svg>
                                        @Html.DisplayFor(modelItem => item.Video.UpdateAt)
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center  small me-3 flex-shrink-0">
                                <span class="badge bg-success-lt me-3">@Html.DisplayFor(modelItem => item.Video.ProcessStatus)</span>
								<span class="badge bg-info-lt me-3">@Html.DisplayFor(modelItem => item.Video.PrivacyStatus)</span>
								<span class="badge bg-azure-lt me-3">@Html.DisplayFor(modelItem => item.Video.Resolution)</span>

                                <div class="d-flex align-items-center me-3" title="觀看次數">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-xs me-1 text-muted" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                                    <span>@item.ViewCount</span>
                                </div>
                                <div class="d-flex align-items-center me-3" title="按讚數">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-xs me-1 text-muted" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 11v8a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1v-7a1 1 0 0 1 1 -1h3l3 -3l3 3v7h-6" /></svg>
                                    <span>@item.LikeCount</span>
                                </div>
                                <div class="d-flex align-items-center" title="留言數">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-xs me-1 text-muted" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 20l1.3 -3.9a9 8 0 1 1 3.4 2.9l-4.7 1" /></svg>
                                    <span>@item.CommentCount</span>
                                </div>
                            </div>

                            <div class="ms-auto d-flex flex-shrink-0 btn-list">
                                <a asp-action="Details" asp-route-id="@item.Video.VideoId" class="btn btn-icon btn-outline-info" title="查看詳情">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Video.VideoId" class="btn btn-icon btn-outline-warning" title="編輯">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" /><path d="M20.385 6.582a1.01 1.01 0 0 0 -4.17 -4.17l-10.4 10.4l-1.35 4.04l4.04 -1.35l10.4 -10.4l-1.35 1.35" /></svg>
                                </a>
                                <button type="button" class="btn btn-icon btn-outline-danger delete-video-btn" data-video-id="@item.Video.VideoId" title="刪除">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7h16" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="list-group-item">
                    <div class="alert alert-warning m-0">
                        <div class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-alert-triangle me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M12 3a9 9 0 0 1 9 9a9 9 0 0 1 -9 9a9 9 0 0 1 -9 -9a9 9 0 0 1 9 -9z" /></svg>
                            <div>
                                <h4>沒有找到符合條件的影片</h4>
                                <p class="mb-0">請嘗試調整搜尋條件或篩選選項。</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="分頁導航" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { 
                        searchTerm = Model.SearchTerm, 
                        searchBy = Model.SearchBy, 
                        sortBy = Model.SortBy, 
                        sortOrder = Model.SortOrder, 
                        page = 1 
                    })" title="首頁">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-chevrons-left" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11 7l-5 5l5 5" /><path d="M17 7l-5 5l5 5" /></svg>
                    </a>
                </li>

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { 
                        searchTerm = Model.SearchTerm, 
                        searchBy = Model.SearchBy, 
                        sortBy = Model.SortBy, 
                        sortOrder = Model.SortOrder, 
                        page = Model.CurrentPage - 1 
                    })" title="上一頁">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-chevron-left" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 6l-6 6l6 6" /></svg>
                    </a>
                </li>

                @{
                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                }

                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            searchTerm = Model.SearchTerm, 
                            searchBy = Model.SearchBy, 
                            sortBy = Model.SortBy, 
                            sortOrder = Model.SortOrder, 
                            page = i 
                        })">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { 
                        searchTerm = Model.SearchTerm, 
                        searchBy = Model.SearchBy, 
                        sortBy = Model.SortBy, 
                        sortOrder = Model.SortOrder, 
                        page = Model.CurrentPage + 1 
                    })" title="下一頁">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-chevron-right" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>
                    </a>
                </li>

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { 
                        searchTerm = Model.SearchTerm, 
                        searchBy = Model.SearchBy, 
                        sortBy = Model.SortBy, 
                        sortOrder = Model.SortOrder, 
                        page = Model.TotalPages 
                    })" title="末頁">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-chevrons-right" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7l5 5l-5 5" /><path d="M13 7l5 5l-5 5" /></svg>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts{
<script>
    // 自動搜尋功能
    let searchTimeout;
    const searchForm = document.getElementById('searchForm');
    const loadingSpinner = document.getElementById('loadingSpinner');
    
    // 顯示載入動畫
    function showLoading() {
        loadingSpinner.classList.remove('d-none');
    }
    
    // 監聽搜尋框輸入 (延遲 500ms 後執行)
    document.getElementById('searchTerm').addEventListener('input', function() {
        clearTimeout(searchTimeout);
        showLoading();
        
        searchTimeout = setTimeout(function() {
            searchForm.submit();
        }, 500);
    });
    
    // 監聽下拉選單變更 (立即執行)
    document.getElementById('searchBy').addEventListener('change', function() {
        showLoading();
        searchForm.submit();
    });
    
    document.getElementById('sortBy').addEventListener('change', function() {
        showLoading();
        searchForm.submit();
    });
    
    document.getElementById('sortOrder').addEventListener('change', function() {
        showLoading();
        searchForm.submit();
    });
    
    // 平滑滾動到頂部 (Tabler的分頁連結點擊)
    document.querySelectorAll('.pagination a').forEach(link => {
        link.addEventListener('click', function(e) {
            // 阻止預設行為，讓分頁連結可以正確觸發
            if (!this.closest('.disabled')) {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });
    });

    // 刪除功能
    document.addEventListener('DOMContentLoaded', function() {
        const deleteButtons = document.querySelectorAll('.delete-video-btn');

        deleteButtons.forEach(button => {
            button.addEventListener('click', function() {
                const videoId = this.getAttribute('data-video-id');
                // 使用原有的 confirm 彈窗
                const confirmation = confirm('確定要刪除這部影片嗎？此操作為軟刪除。');

                if (confirmation) {
                    const url = `/Videos/Videos/DeleteVideo/${videoId}`; 
                    
                    fetch(url, {
                        method: 'DELETE',
                        headers: {
                            // 加上 Content-Type: application/json 是良好的實踐，雖然 DELETE 請求體通常為空
                            'Content-Type': 'application/json' 
                        }
                    })
                    .then(response => {
                        if (response.ok) {
                            alert('影片刪除成功！');
                            window.location.reload(); 
                        } else {
                            // 嘗試解析錯誤訊息
                            return response.json()
                                .then(data => {
                                    alert('刪除失敗: ' + (data.message || response.statusText));
                                })
                                .catch(() => {
                                    // 如果無法解析 JSON，就顯示 HTTP 狀態碼
                                    alert('刪除失敗，錯誤狀態碼: ' + response.status);
                                });
                        }
                    })
                    .catch(error => {
                        console.error('刪除請求出錯:', error);
                        alert('刪除請求出錯，請檢查網路連線或稍後再試。');
                    });
                }
            });
        });
    });
</script>
}
