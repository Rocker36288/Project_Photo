@model Project_Photo.Areas.Videos.ViewModels.EditVideoViewModel

@{
    ViewData["Title"] = "修改影片";
}

<div class="container-xl">
    <div class="page-header d-print-none mb-4">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <i class="ti ti-pencil me-2 text-warning"></i>修改影片
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    @{
                        string returnUrl = Context.Request.Query["returnUrl"].ToString();
                        string defaultReturnUrl = Url.Action("Index", "Videos");
                        string finalRedirectUrl = string.IsNullOrEmpty(returnUrl) ? defaultReturnUrl : returnUrl;
                    }
                    <a href="javascript:void(0)" class="btn btn-outline-secondary"
                       onclick="document.referrer && document.referrer != location.href ? history.back() : location.href='@finalRedirectUrl'">
                        <i class="ti ti-arrow-left me-1"></i>返回上一頁
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 左側預覽區 -->
        <div class="col-lg-4">
            <div class="card sticky-top">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-eye me-2"></i>預覽
                    </h3>
                </div>
                <div class="card-body p-3">
                    <!-- 影片/縮圖預覽 -->
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.VideoUrl))
                        {
                            <div class="ratio ratio-16x9 rounded overflow-hidden shadow-sm mb-2 border">
                                <video controls poster="@Model.ThumbnailUrl" class="w-100" id="videoPreview">
                                    <source src="@Model.VideoUrl" type="video/mp4">
                                    您的瀏覽器不支援影片標籤。
                                </video>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                        {
                            <img src="@Model.ThumbnailUrl" class="img-fluid rounded shadow-sm w-100" id="videoThumbnailPreview" alt="Thumbnail">
                        }
                        else
                        {
                            <div class="ratio ratio-16x9 bg-secondary-lt rounded d-flex align-items-center justify-content-center">
                                <div class="text-center text-muted">
                                    <i class="ti ti-video-off fs-1"></i>
                                    <p class="mb-0 mt-2">無預覽</p>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- 唯讀資訊卡片 -->
                    <div class="card card-body bg-light-lt border-0 p-3 text-dark">
                        <h6 class="text-muted mb-3">
                            <i class="ti ti-lock me-1"></i>唯讀訊息
                        </h6>
                        <dl class="mb-0 small row">
                            <dt class="col-5 text-muted">Video ID</dt>
                            <dd class="col-7 mb-2">
                                <span class="badge bg-azure-lt">@Model.VideoId</span>
                            </dd>

                            <dt class="col-5 text-muted">Channel ID</dt>
                            <dd class="col-7 mb-2">
                                <span class="badge bg-purple-lt">@Model.ChannelId</span>
                            </dd>

                            <dt class="col-5 text-muted">Video URL</dt>
                            <dd class="col-7 text-truncate mb-2">
                                <small class="font-monospace text-dark" title="@(Model.VideoUrl ?? "N/A")">
                                    @(Model.VideoUrl ?? "N/A")
                                </small>
                            </dd>

                            <dt class="col-5 text-muted">時長</dt>
                            <dd class="col-7 mb-2">
                                @if (Model.Duration.HasValue)
                                {
                                    <strong>@(TimeSpan.FromSeconds(Convert.ToDouble(Model.Duration)).ToString(@"mm\:ss"))</strong>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </dd>

                            <dt class="col-5 text-muted">解析度</dt>
                            <dd class="col-7 mb-2">
                                <span class="badge bg-info-lt">@(Model.Resolution ?? "N/A")</span>
                            </dd>

                            <dt class="col-5 text-muted">文件大小</dt>
                            <dd class="col-7 mb-2">
                                @{
                                    long fileSize = Model.FileSize ?? 0;
                                    string readableSize;
                                    if (fileSize >= 1024 * 1024 * 1024)
                                    {
                                        readableSize = (fileSize / (1024.0 * 1024 * 1024)).ToString("0.##") + " GB";
                                    }
                                    else if (fileSize >= 1024 * 1024)
                                    {
                                        readableSize = (fileSize / (1024.0 * 1024)).ToString("0.##") + " MB";
                                    }
                                    else if (fileSize >= 1024)
                                    {
                                        readableSize = (fileSize / 1024.0).ToString("0.##") + " KB";
                                    }
                                    else
                                    {
                                        readableSize = fileSize + " B";
                                    }
                                }
                                <strong>@readableSize</strong>
                            </dd>

                            <dt class="col-5 text-muted">建立日期</dt>
                            <dd class="col-7 mb-0">
                                @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側表單區 -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-warning-lt">
                    <h3 class="card-title text-dark">
                        <i class="ti ti-file-text me-2"></i>修改影片資訊
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <!-- 隱藏欄位 - 保留所有唯讀資料 -->
                        <input type="hidden" asp-for="VideoId" />
                        <input type="hidden" asp-for="ChannelId" />
                        <input type="hidden" asp-for="VideoUrl" />
                        <input type="hidden" asp-for="Duration" />
                        <input type="hidden" asp-for="Resolution" />
                        <input type="hidden" asp-for="FileSize" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="ThumbnailUrl" id="thumbnailUrlHidden" />

                        <!-- 基本資訊 -->
                        <fieldset class="mb-4">
                            <legend class="border-bottom pb-2 mb-3 text-primary">
                                <i class="ti ti-info-circle me-2"></i>基本資訊
                            </legend>

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label fw-semibold required">
                                    <i class="ti ti-tag me-1"></i>標題
                                </label>
                                <input asp-for="Title" class="form-control form-control-lg" placeholder="輸入影片標題" required />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    <i class="ti ti-paragraph me-1"></i>說明
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="5" placeholder="輸入影片描述"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                                <div class="form-text">提供影片內容的詳細描述</div>
                            </div>
                        </fieldset>

                        <!-- 縮圖設置 -->
                        <fieldset class="mb-4">
                            <legend class="border-bottom pb-2 mb-3 text-primary">
                                <i class="ti ti-photo-edit me-2"></i>縮圖設置
                            </legend>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="ti ti-photo me-1"></i>目前縮圖
                                </label>
                                <div class="card card-body bg-light-lt border-dashed text-center p-3" id="currentThumbnailZone">
                                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                                    {
                                        <img src="@Model.ThumbnailUrl" id="currentThumbnail" class="img-fluid rounded mb-2 mx-auto" alt="Current Thumbnail" style="max-height: 200px; max-width: 100%;">
                                        <div class="text-muted small mt-2">
                                            <i class="ti ti-folder me-1"></i>@Model.ThumbnailUrl
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted py-4">
                                            <i class="ti ti-photo-off fs-1"></i>
                                            <p class="mb-0">未上傳縮圖</p>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="thumbnailFile" class="form-label fw-semibold">
                                    <i class="ti ti-replace me-1"></i>替換縮圖
                                </label>
                                <input type="file"
                                       class="form-control"
                                       id="thumbnailFile"
                                       name="ThumbnailFile"
                                       accept="image/jpeg, image/png, image/gif"
                                       onchange="previewThumbnail(this)">
                                <div class="form-text">
                                    <i class="ti ti-info-circle me-1"></i>
                                    上傳新圖片以取代目前縮圖，原文件將被覆蓋。
                                    <br>支援格式: JPG, PNG, GIF (最大 5MB, 推薦 1280x720)
                                </div>
                            </div>

                            <!-- 新縮圖預覽 -->
                            <div id="newThumbnailPreview" class="mb-3" style="display: none;">
                                <label class="form-label fw-semibold text-success">
                                    <i class="ti ti-eye-check me-1"></i>新縮圖預覽
                                </label>
                                <div class="card border-success">
                                    <div class="card-body text-center p-3">
                                        <img id="thumbnailPreview" class="img-fluid rounded mx-auto" style="max-height: 200px; max-width: 100%;" alt="New Thumbnail Preview">
                                        <div class="mt-3">
                                            <span class="badge bg-yellow text-dark">
                                                <i class="ti ti-alert-triangle me-1"></i>這將覆蓋現有檔案
                                            </span>
                                            <div class="mt-2">
                                                <button type="button" class="btn btn-sm btn-danger" onclick="clearThumbnailUpload()">
                                                    <i class="ti ti-x me-1"></i>取消上傳
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>

                        <!-- 狀態設置 -->
                        <fieldset class="mb-4">
                            <legend class="border-bottom pb-2 mb-3 text-primary">
                                <i class="ti ti-settings-cog me-2"></i>狀態設置
                            </legend>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ProcessStatus" class="form-label fw-semibold">
                                        <i class="ti ti-loader me-1"></i>處理狀態
                                    </label>
                                    <select asp-for="ProcessStatus" class="form-select">
                                        <option value="Pending">待處理</option>
                                        <option value="Processing">處理中</option>
                                        <option value="Published">已發佈</option>
                                        <option value="Failed">失敗</option>
                                    </select>
                                    <span asp-validation-for="ProcessStatus" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="PrivacyStatus" class="form-label fw-semibold">
                                        <i class="ti ti-lock-access me-1"></i>隱私狀態
                                    </label>
                                    <select asp-for="PrivacyStatus" class="form-select">
                                        <option value="Public">公開</option>
                                        <option value="Private">私人</option>
                                        <option value="Unlisted">不公開</option>
                                    </select>
                                    <span asp-validation-for="PrivacyStatus" class="text-danger"></span>
                                </div>
                            </div>
                        </fieldset>

                        <!-- 操作按鈕 -->
                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="ti ti-device-floppy me-1"></i>儲存修改
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.VideoId" class="btn btn-secondary btn-lg">
                                <i class="ti ti-eye me-1"></i>查看詳情
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg ms-auto">
                                <i class="ti ti-list me-1"></i>返回列表
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // 儲存原始縮圖 URL
        const originalThumbnailUrl = '@Model.ThumbnailUrl';

        // 取得所有需要的元素
        const videoElement = document.querySelector('#videoPreview');
        const thumbnailImgElement = document.querySelector('#videoThumbnailPreview');
        const currentThumbnailElement = document.querySelector('#currentThumbnail');

        /**
         * 預覽選擇的縮圖
         */
        function previewThumbnail(input) {
            const file = input.files[0];
            const previewContainer = document.getElementById('newThumbnailPreview');
            const previewImg = document.getElementById('thumbnailPreview');

            if (!file) {
                clearThumbnailPreview();
                return;
            }

            // 檔案大小驗證 (5MB)
            if (file.size > 5 * 1024 * 1024) {
                alert('檔案大小超過 5MB 限制，請選擇較小的檔案。');
                input.value = '';
                clearThumbnailPreview();
                return;
            }

            // 檔案類型驗證
            if (!file.type.match('image.*')) {
                alert('請上傳圖片檔案 (JPG, PNG, GIF)。');
                input.value = '';
                clearThumbnailPreview();
                return;
            }

            // 讀取並預覽圖片
            const reader = new FileReader();
            reader.onload = function (e) {
                const newSrc = e.target.result;
                
                // 更新新縮圖預覽區
                previewImg.src = newSrc;
                previewContainer.style.display = 'block';

                // 更新左側預覽
                updateLeftSidePreview(newSrc);

                // 更新「目前縮圖」區域
                if (currentThumbnailElement) {
                    currentThumbnailElement.src = newSrc;
                }
            };
            reader.readAsDataURL(file);
        }

        /**
         * 更新左側預覽區
         */
        function updateLeftSidePreview(newSrc) {
            if (videoElement) {
                // 如果是影片，更新 poster
                videoElement.poster = newSrc;
            } else if (thumbnailImgElement) {
                // 如果是圖片，更新 src
                thumbnailImgElement.src = newSrc;
            }
        }

        /**
         * 清除縮圖預覽並還原原始狀態
         */
        function clearThumbnailPreview() {
            const previewContainer = document.getElementById('newThumbnailPreview');
            previewContainer.style.display = 'none';

            // 還原左側預覽
            if (videoElement) {
                videoElement.poster = originalThumbnailUrl;
            } else if (thumbnailImgElement) {
                thumbnailImgElement.src = originalThumbnailUrl;
            }

            // 還原「目前縮圖」區域
            if (currentThumbnailElement) {
                currentThumbnailElement.src = originalThumbnailUrl;
            }
        }

        /**
         * 清除上傳的縮圖檔案
         */
        function clearThumbnailUpload() {
            const fileInput = document.getElementById('thumbnailFile');
            fileInput.value = '';
            clearThumbnailPreview();
        }

        /**
         * 拖放上傳功能
         */
        const dropZone = document.getElementById('currentThumbnailZone');
        const thumbnailInput = document.getElementById('thumbnailFile');

        if (dropZone && thumbnailInput) {
            // 拖曳進入
            dropZone.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.stopPropagation();
                this.classList.add('border-primary', 'bg-primary-lt');
            });

            // 拖曳離開
            dropZone.addEventListener('dragleave', function(e) {
                e.preventDefault();
                e.stopPropagation();
                this.classList.remove('border-primary', 'bg-primary-lt');
            });

            // 放下檔案
            dropZone.addEventListener('drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                this.classList.remove('border-primary', 'bg-primary-lt');
                
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    // 將檔案傳給 input 元素
                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(files[0]);
                    thumbnailInput.files = dataTransfer.files;
                    
                    // 觸發預覽
                    previewThumbnail(thumbnailInput);
                }
            });
        }

        // 表單提交前驗證
        document.querySelector('form').addEventListener('submit', function(e) {
            const title = document.querySelector('input[name="Title"]').value.trim();
            
            if (!title) {
                e.preventDefault();
                alert('請輸入影片標題');
                return false;
            }
        });
    </script>

    <style>
        .is-drag-over {
            border-color: var(--tblr-primary) !important;
            background-color: var(--tblr-primary-lt) !important;
        }

        .sticky-top {
            position: sticky;
            top: 1rem;
            z-index: 1020;
        }

        .required::after {
            content: " *";
            color: #d63939;
        }
    </style>
}
