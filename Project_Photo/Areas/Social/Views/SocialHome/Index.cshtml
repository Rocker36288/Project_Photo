@model IEnumerable<Project_Photo.Models.Post>

@{
    ViewData["Title"] = "Home";
}
@section Styles
{
    <style>
        .btn-custom {
            background-color: transparent !important;
            color: #000 !important;
            width: 100%;
            border: none;
            border-radius: 0;
            display: flex;
            align-items: center;
            justify-content: flex-start; /* 左對齊 */
            gap: 0.5rem; /* 圖示與文字間距 */
            padding-left: 0.75rem; /* 可微調 */
        }

            .btn-custom:hover {
                background-color: #e2e6ea !important;
                color: #000 !important;
                text-decoration: none;
            }

        .btn-up {
            position: fixed;
            bottom: 20px;
            right: 20px;
            display: none;
            z-index: 1000;
            background-color: #0d6efd;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
        }
        
        /* 編輯刪除選單 */
        .dropdown-menu-xs {
            min-width: 20px;
            padding: 0.25rem 0;
        }

        .dropdown-menu-xs .dropdown-item {
            padding: 0.25rem 0.75rem !important;
            font-size: 0.85rem;
        }
    </style>
}
<div class="container-fluid bg-light" style="min-height:100vh;">
    <div class="row">

        <!-- 左側欄（功能選單） -->
        <div class="col-md-3 col-sm-12 p-3">
            <div class="card shadow-sm" style="position:sticky; top: 20px;">
                <div class="card-body">
                    <h3 class="mb-3">選單</h3>
                    <div class="btn-group-vertical w-100" role="group">
                        <a class="nav-link btn btn-custom" asp-area="Social" asp-controller="SocialHome" asp-action="Index">
                            <i class="bi bi-house"></i> 首頁
                        </a>
                        <a class="nav-link btn btn-custom" asp-area="Social" asp-controller="Posts" asp-action="Index">
                            <i class="bi bi-people"></i> 貼文管理
                        </a>
                        <a class="nav-link btn btn-custom" href="#">
                            <i class="bi bi-people"></i> 朋友
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 中間欄（貼文區域） -->
        <div class="col-md-6 col-sm-12 p-3">

            <!-- 發文區塊 -->
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <form id="postForm" asp-action="CreatePost" method="post">
                        <textarea id="postContent" name="PostContent" class="form-control" rows="2" placeholder="你在想什麼？"></textarea>
                        <button type="submit" class="btn btn-primary mt-2 w-100">發佈貼文</button>
                    </form>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                @foreach (var post in Model)
                {
                    <div class="card mb-3" id="post-card-@post.PostId">
                        <div class="card-body">
                            <!-- 功能選單（右上角） -->
                            <div class="position-absolute top-0 end-0 m-2">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown">
                                        ...
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-xs">
                                        <li>
                                            <button class="dropdown-item" onclick="enterEditMode(@post.PostId)">
                                                編輯
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item text-danger" onclick="deletePost(@post.PostId)">
                                                刪除
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- 頭貼 + UserId + 時間 -->
                            <div class="d-flex align-items-center mb-2">
                                <img src="~/img/social/Among Us.png"
                                     class="rounded-circle me-2"
                                     style="width:50px; height:50px" />

                                <div>
                                    <strong>UserId: @post.UserId</strong><br />
                                    <span class="text-muted" style="font-size: 0.85rem;">
                                        @post.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                </div>
                            </div>
                            <!-- 顯示貼文文字內容 -->
                            <p id="content-@post.PostId">@post.PostContent</p>

                            <div id="edit-area-@post.PostId" style="display:none;">
                                <textarea id="edit-text-@post.PostId" class="form-control">@post.PostContent</textarea>
                                <button class="btn btn-success btn-sm mt-2" onclick="saveEdit(@post.PostId)">保存</button>
                                <button class="btn btn-secondary btn-sm mt-2" onclick="cancelEdit(@post.PostId)">取消</button>
                            </div>

                            @* @if (post.PostImages.Any())  <!-- 等之後再連到照片 -->
                        {
                            foreach (var img in post.PostImages)
                            {
                                <img src="@img.ImageUrl" class="img-fluid mb-2" />
                            }
                        } *@

                            <div>
                                👍 @post.PostLikes.Count()
                                💬 @post.InverseParentPost.Count()
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>目前還沒有貼文。</p>
            }
            @* <!-- 假貼文範例 -->
            @for (int i = 0; i < 10; i++)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <img src="https://via.placeholder.com/40" class="rounded-circle me-2" />
                            <div>
                                <strong>使用者 @i</strong><br />
                                <small class="text-muted">10 分鐘前</small>
                            </div>
                        </div>
                        <p>這是一則範例貼文內容，看起來像 Facebook Feed。</p>
                        <img src="https://via.placeholder.com/600x300" class="img-fluid rounded mb-2" />

                        <div class="d-flex justify-content-between">
                            <button class="btn btn-light w-100 me-1">👍 讚</button>
                            <button class="btn btn-light w-100 ms-1">💬 留言</button>
                        </div>
                    </div>
                </div>
            } *@
        </div>

        <!-- 右側欄（朋友列表 / 廣告） -->
        <div class="col-md-3 col-sm-12 p-3">
            <div class="card shadow-sm" style="position:sticky; top: 20px;">
                <div class="card-body">
                    <h3 class="mb-3">線上朋友</h3>

                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="d-flex align-items-center mb-2">
                            @* <img src="https://via.placeholder.com/35" class="rounded-circle me-2" />    好友頭像 *@
                            <span>好友 @i</span>
                            <span class="badge bg-success ms-auto" style="width:10px;height:10px;border-radius:50%;"></span>
                        </div>
                    }
                </div>
            </div>
            <button class="btn-up" id="backToTopBtn">
                ↑ 回到最上面
            </button>
        </div>
    </div>
</div>


@section Scripts
{
    <script>
        const form = document.getElementById('postForm');
        const textarea = document.getElementById('postContent');
        let isDirty = false;

        // 當使用者在 textarea 打字時，標記為「有修改」
        textarea.addEventListener('input', () => {
            isDirty = textarea.value.trim().length > 0;
        });

        // 提交表單時，重置標記，避免送出後還提示
        form.addEventListener('submit', () => {
            isDirty = false;
        });

        // 離開頁面前檢查是否有未送出的內容
        window.addEventListener('beforeunload', (e) => {
            if (isDirty) {
                e.preventDefault();
                e.returnValue = ''; // 某些瀏覽器需要設定 returnValue
            }
        });
    </script>

    <script>
        // 顯示或隱藏按鈕
        window.onscroll = function() {scrollFunction()};

        function scrollFunction() {
            const btn = document.getElementById("backToTopBtn");
            if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) {
                btn.style.display = "block";
            } else {
                btn.style.display = "none";
            }
        }

        // 點擊按鈕回到最上面
        document.getElementById("backToTopBtn").addEventListener("click", function(){
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>


    <script>
        //進入/退出編輯模式
                function enterEditMode(id) {
            document.getElementById("content-" + id).style.display = "none";
            document.getElementById("edit-area-" + id).style.display = "block";
        }

        function cancelEdit(id) {
            document.getElementById("content-" + id).style.display = "block";
            document.getElementById("edit-area-" + id).style.display = "none";
        }

        //儲存編輯後的貼文
                        function saveEdit(id) {
            const newContent = document.getElementById("edit-text-" + id).value;

            fetch('/Social/Posts/EditPost', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: id,
                    content: newContent
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById("content-" + id).innerText = newContent;
                    cancelEdit(id);
                }
            });
        }


        //AJAX 刪除 & UI 移除
                        function deletePost(id) {
            if (!confirm("確定要刪除嗎？")) return;

            fetch('/Social/Posts/DeletePost', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: id
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById("post-card-" + id).remove();
                }
            });
        }


    </script>


}
