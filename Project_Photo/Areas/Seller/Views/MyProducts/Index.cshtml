@* /Areas/Seller/Views/MyProducts/Index.cshtml *@

@model Project_Photo.ViewModels.SellerProductListViewModel
@{
    ViewData["Title"] = "我的商品管理";
    // 確保這裡的路徑與您 Area 內的 _Layout 檔案路徑一致
    Layout = "~/Areas/Seller/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h3>我的商品管理</h3>
    <hr />

    <form asp-area="Seller" asp-controller="MyProducts" asp-action="Index" method="get" class="mb-4">
        <div class="row g-3 align-items-center">

            @* 搜尋文字框 *@
            <div class="col-auto">
                <input type="text" name="search" class="form-control" placeholder="搜尋商品名稱" value="@Model.SearchQuery" />
            </div>

            @* 狀態下拉選單 (使用最安全的方式處理 selected 屬性) *@
            <div class="col-auto">
                <select name="status" class="form-select">
                    @{
                        // 處理 RZ1031 錯誤的最佳兼容性方案
                        var statuses = new List<string> { "全部", "上架中", "已下架", "待審核" };
                        foreach (var s in statuses)
                        {
                            if (Model.SelectedStatus == s)
                            {
                                <option value="@s" selected>@(s == "全部" ? "全部狀態" : s)</option>
                            }
                            else
                            {
                                <option value="@s">@(s == "全部" ? "全部狀態" : s)</option>
                            }
                        }
                    }
                </select>
            </div>

            @* 搜尋按鈕：已替換為 SVG 圖示 *@
            <div class="col-auto">
                <button type="submit" class="btn btn-primary" title="搜尋">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-search" width="20" height="20" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg>
                    <span class="d-none d-sm-inline ms-1">搜尋</span>
                </button>
            </div>

            @* 【修正 3：新增商品按鈕改為紅色】 *@
            <div class="col-auto ms-auto">
                <a asp-area="Seller" asp-controller="MyProducts" asp-action="Create" class="btn btn-danger">新增商品</a>
            </div>
        </div>
    </form>

    <p class="text-muted">
        共找到 **@Model.TotalProducts** 件商品。
    </p>

    <div class="product-grid mt-4">

        @if (Model.Products != null && Model.Products.Count > 0)
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4">

                @foreach (var item in Model.Products)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">

                            <img src="@(item.MainImageUrl ?? "/img/no-image.png")" class="card-img-top" alt="@item.ProductName" style="height: 180px; object-fit: cover;" onerror="this.src='/img/no-image.png'; this.onerror=null;">
                            <div class="card-body d-flex flex-column p-3">

                                <h6 class="card-title text-truncate mb-1">@item.ProductName</h6>

                                <p class="text-danger fw-bold fs-5 mb-1">
                                    @String.Format("NT$ {0:N0}", item.Price)
                                </p>

                                <div class="d-flex justify-content-between text-muted small mt-auto">
                                    <span>銷量: @item.SalesCount</span>
                                    <span>庫存: @item.StockQuantity</span>
                                </div>
                            </div>

                            <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge rounded-pill bg-@(@item.Status == "上架中" ? "success" : "secondary")">@item.Status</span>
                                </div>

                                <div>
                                    <a asp-area="Seller" asp-controller="MyProducts" asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-primary me-1" title="編輯">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-pencil" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" /><path d="M13.5 6.5l4 4" /></svg>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="刪除"
                                                onclick="return confirm('您確定要刪除商品：@item.ProductName 嗎？這個操作無法復原。');">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-trash" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 7l16 0" /><path d="M10 11l0 6" /><path d="M14 11l0 6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info text-center mt-5" role="alert">
                目前沒有找到符合條件的商品。
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-area="Seller" asp-controller="MyProducts" asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-search="@Model.SearchQuery"
                       asp-route-status="@Model.SelectedStatus">上一頁</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-area="Seller" asp-controller="MyProducts" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@Model.SearchQuery"
                           asp-route-status="@Model.SelectedStatus">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-area="Seller" asp-controller="MyProducts" asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-search="@Model.SearchQuery"
                       asp-route-status="@Model.SelectedStatus">下一頁</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        function confirmDelete(productId) {
            if (confirm("確定要刪除此商品嗎？")) {
                console.log("嘗試刪除商品 ID：" + productId);
            }
        }
    </script>
}