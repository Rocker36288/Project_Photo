@model Project_Photo.Models.PhotoSubscriptionPlan

@{
    ViewData["Title"] = "編輯訂閱方案";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">
                    訂閱管理
                </div>
                <h2 class="page-title">
                    編輯訂閱方案
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="Index" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0" fill="none"></path>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <line x1="5" y1="12" x2="9" y2="16"></line>
                            <line x1="5" y1="12" x2="9" y2="8"></line>
                        </svg>
                        返回列表
                    </a>
                    <a asp-action="Details" asp-route-id="@Model.PlanId" class="btn btn-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><line x1="4" y1="4" x2="20" y2="20" /><line x1="4" y1="20" x2="20" y2="4" /></svg>
                        取消編輯
                    </a>
                    <button type="submit" form="editPlanForm" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0" fill="none"></path>
                            <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"></path>
                            <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z"></path>
                            <path d="M16 5l3 3"></path>
                        </svg>
                        儲存變更
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible" role="alert">
                <div class="d-flex">
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0" fill="none" /><circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    </div>
                    <div>
                        @TempData["Error"]
                    </div>
                </div>
                <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
            </div>
        }

        <form asp-action="Edit" asp-route-id="@Model.PlanId" method="post" id="editPlanForm">
            <input type="hidden" asp-for="PlanId" />

            <div class="row row-deck row-cards">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">基本資訊</h3>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label required">方案代碼</label>
                                    <input type="text" class="form-control" asp-for="PlanCode" placeholder="例如: PLAN_FREE" maxlength="50" required>
                                    <span asp-validation-for="PlanCode" class="text-danger"></span>
                                    <small class="form-hint">英文代碼，用於系統識別</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label required">方案名稱</label>
                                    <input type="text" class="form-control" asp-for="PlanName" placeholder="例如: 免費方案" maxlength="100" required>
                                    <span asp-validation-for="PlanName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">方案說明</label>
                                <textarea class="form-control" asp-for="PlanDescription" rows="3" placeholder="請輸入方案說明..." maxlength="200"></textarea>
                                <span asp-validation-for="PlanDescription" class="text-danger"></span>
                                <small class="form-hint">最多 200 字元</small>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label required">方案等級</label>
                                    <select class="form-select" asp-for="PlanLevel" id="planLevelSelect" required>
                                        <option value="">請選擇方案等級</option>
                                        <option value="1">1 - 免費</option>
                                        <option value="2">2 - 基本</option>
                                        <option value="3">3 - 進階</option>
                                        <option value="4">4 - 專業</option>
                                    </select>
                                    <span asp-validation-for="PlanLevel" class="text-danger"></span>
                                    <small class="form-hint d-flex align-items-center mt-1">
                                        等級預覽：<span id="planLevelBadge" class="badge ms-2" style="visibility: hidden;"></span>
                                    </small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label required">月費 (NT$)</label>
                                    <input type="number" class="form-control" asp-for="MonthlyPrice" placeholder="0" min="0" step="1" required>
                                    <span asp-validation-for="MonthlyPrice" class="text-danger"></span>
                                    <small class="form-hint">免費方案請輸入 0</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label required">所屬系統</label>
                                <select class="form-select" asp-for="SystemId" required>
                                    <option value="">請選擇所屬系統</option>
                                    @if (ViewBag.Systems != null)
                                    {
                                        @foreach (var system in ViewBag.Systems)
                                        {
                                            <option value="@system.SystemId" selected="@(system.SystemId == Model.SystemId)">
                                                @system.SystemName (@system.SystemCode)
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SystemId" class="text-danger"></span>
                            </div>

                            <div class="mb-0">
                                <label class="form-label">方案特色 (JSON 格式)</label>
                                <textarea class="form-control font-monospace" asp-for="Features" rows="6" placeholder='{"storage": "100GB", "users": 10, "support": "Email"}'></textarea>
                                <span asp-validation-for="Features" class="text-danger"></span>
                                <small class="form-hint">請輸入有效的 JSON 格式，例如: {"key": "value"}</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-2">
                    <!-- 狀態與時間資訊卡片 -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">狀態與時間資訊</h3>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">方案狀態</label>
                                <label class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                    <span class="form-check-label">啟用此方案</span>
                                </label>
                                <small class="form-hint d-block">
                                    啟用後，此方案才能在系統中使用
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">公開設定</label>
                                <label class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" asp-for="IsPublic">
                                    <span class="form-check-label">公開顯示</span>
                                </label>
                                <small class="form-hint d-block">
                                    公開後，用戶可在前台看到此方案
                                </small>
                            </div>

                            <hr class="my-3">

                            <div class="datagrid">
                                <div class="datagrid-item">
                                    <div class="datagrid-title">建立時間</div>
                                    <div class="datagrid-content">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">最後更新</div>
                                    <div class="datagrid-content">@Model.UpdateAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-2">

                    <!-- 注意事項卡片 -->
                    <div class="card mb-3">
                        <div class="card-header bg-warning-lt">
                            <h3 class="card-title">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-alert-circle me-2 text-warning" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0" fill="none"></path>
                                    <path d="M12 9v2m0 4v.01"></path>
                                    <path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75"></path>
                                </svg>
                                注意事項
                            </h3>
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-warning me-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0" fill="none" /><path d="M5 12l5 5l10 -10" /></svg>
                                    修改方案等級<strong>可能影響排序</strong>
                                </li>
                                <li class="mb-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-warning me-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0" fill="none" /><path d="M5 12l5 5l10 -10" /></svg>
                                    修改月費<strong>不影響現有訂閱</strong>
                                </li>
                                <li class="mb-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-warning me-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0" fill="none" /><path d="M5 12l5 5l10 -10" /></svg>
                                    停用方案<strong>不會影響已訂閱用戶</strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const featuresTextarea = document.querySelector('textarea[name="Features"]');
        const planLevelSelect = document.querySelector('#planLevelSelect');
        const planLevelBadge = document.querySelector('#planLevelBadge');

        // 等級顏色對應表
        const levelColors = {
            '1': { text: '免費方案', class: 'bg-secondary-lt' },
            '2': { text: '基本方案', class: 'bg-info-lt' },
            '3': { text: '進階方案', class: 'bg-primary-lt' },
            '4': { text: '專業方案', class: 'bg-success-lt' }
        };

        // 函數：更新方案等級預覽標籤
        function updatePlanLevelBadge(level) {
            const data = levelColors[level];

            // 重置所有 class
            planLevelBadge.className = 'badge ms-2';

            if (data) {
                planLevelBadge.textContent = data.text;
                planLevelBadge.classList.add(data.class);
                planLevelBadge.style.visibility = 'visible';
            } else {
                planLevelBadge.textContent = '';
                planLevelBadge.style.visibility = 'hidden';
            }
        }

        // 1. JSON 格式驗證
        if (featuresTextarea) {
            featuresTextarea.addEventListener('blur', function() {
                const value = this.value.trim();
                const validationTarget = document.querySelector('span[data-valmsg-for="Features"]'); // 假設這是你的驗證訊息元素

                if (value && value !== '') {
                    try {
                        JSON.parse(value);
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                        if (validationTarget) validationTarget.textContent = '';
                    } catch (e) {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                        if (validationTarget) validationTarget.textContent = '請輸入有效的 JSON 格式';
                    }
                } else {
                    this.classList.remove('is-invalid');
                    this.classList.remove('is-valid');
                    if (validationTarget) validationTarget.textContent = '';
                }
            });
            // 初始化時檢查一次 (如果 Model.Features 有值)
            if (featuresTextarea.value.trim() !== '') {
                 featuresTextarea.dispatchEvent(new Event('blur'));
            }
        }

        // 2. 方案等級即時預覽
        if (planLevelSelect) {
            planLevelSelect.addEventListener('change', function() {
                updatePlanLevelBadge(this.value);
            });
            // 初始化等級預覽
            updatePlanLevelBadge(planLevelSelect.value);
        }

        // 3. 月費格式化 (使用新的 ID/Selector)
        const monthlyPriceInput = document.querySelector('input[name="MonthlyPrice"]');
        if (monthlyPriceInput) {
            monthlyPriceInput.addEventListener('blur', function() {
                if (this.value) {
                    // 確保是數字且非負整數
                    this.value = Math.max(0, parseInt(this.value) || 0);
                }
            });
        }

        // 4. 表單提交前確認
        document.querySelector('form').addEventListener('submit', function(e) {
            // 可以在這裡加入額外的客戶端驗證，例如檢查 JSON 欄位是否為 invalid
            if (featuresTextarea && featuresTextarea.classList.contains('is-invalid')) {
                 // 如果 JSON 格式錯誤，阻止提交
                 alert('JSON 格式錯誤，請修正後再儲存。');
                 e.preventDefault();
                 return false;
            }
            console.log('準備儲存方案...');
        });
    </script>
}