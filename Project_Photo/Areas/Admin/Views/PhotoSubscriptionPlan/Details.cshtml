@model Project_Photo.Models.PhotoSubscriptionPlan

@{
    ViewData["Title"] = "方案詳細資訊";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">
                    訂閱管理
                </div>
                <h2 class="page-title">
                    @Model.PlanName
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="Index" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <line x1="5" y1="12" x2="9" y2="16" />
                            <line x1="5" y1="12" x2="9" y2="8" />
                        </svg>
                        返回列表
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.PlanId" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
                            <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" />
                            <path d="M16 5l3 3" />
                        </svg>
                        編輯方案
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                <div class="d-flex">
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M5 12l5 5l10 -10" />
                        </svg>
                    </div>
                    <div>
                        @TempData["Success"]
                    </div>
                </div>
                <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
            </div>
        }

        <div class="row row-deck row-cards">
            <!-- 基本資訊 -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">基本資訊</h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">方案代碼</div>
                                <div class="datagrid-content">@Model.PlanCode</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">方案名稱</div>
                                <div class="datagrid-content">@Model.PlanName</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">方案說明</div>
                                <div class="datagrid-content">
                                    @if (!string.IsNullOrEmpty(Model.PlanDescription))
                                    {
                                        @Model.PlanDescription
                                    }
                                    else
                                    {
                                        <span class="text-muted">無說明</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">方案等級</div>
                                <div class="datagrid-content">
                                    @switch (Model.PlanLevel)
                                    {
                                        case 1:
                                            <span class="badge bg-secondary-lt">免費</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-info-lt">基本</span>
                                            break;
                                        case 3:
                                            <span class="badge bg-primary-lt">進階</span>
                                            break;
                                        case 4:
                                            <span class="badge bg-success-lt">專業</span>
                                            break;
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">月費</div>
                                <div class="datagrid-content">
                                    @if (Model.MonthlyPrice == 0)
                                    {
                                        <span class="text-success fw-bold">免費</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold">NT$ @Model.MonthlyPrice.ToString("N0")</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">所屬系統</div>
                                <div class="datagrid-content">
                                    @if (Model.System != null)
                                    {
                                        @Model.System.SystemName
                                        <span class="text-muted">(@Model.System.SystemCode)</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 狀態資訊 -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">狀態資訊</h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">啟用狀態</div>
                                <div class="datagrid-content">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success-lt">啟用</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-lt">停用</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">公開狀態</div>
                                <div class="datagrid-content">
                                    @if (Model.IsPublic)
                                    {
                                        <span class="badge bg-success-lt">公開</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt">不公開</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">建立時間</div>
                                <div class="datagrid-content">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">更新時間</div>
                                <div class="datagrid-content">@Model.UpdateAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 方案特色 -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">方案特色</h3>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.Features))
                        {
                            <div class="alert alert-info">
                                <h4 class="alert-title">JSON 格式特色資料</h4>
                                <pre class="mb-0"><code>@Model.Features</code></pre>
                            </div>
                        }
                        else
                        {
                            <div class="empty">
                                <div class="empty-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <circle cx="12" cy="12" r="9" />
                                        <line x1="9" y1="10" x2="9.01" y2="10" />
                                        <line x1="15" y1="10" x2="15.01" y2="10" />
                                        <path d="M9.5 15.25a3.5 3.5 0 0 1 5 0" />
                                    </svg>
                                </div>
                                <p class="empty-title">尚未設定方案特色</p>
                                <p class="empty-subtitle text-muted">
                                    目前此方案尚未設定任何特色資訊
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 快速操作 -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">快速操作</h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <form method="post" asp-action="ToggleActive" asp-route-id="@Model.PlanId">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-@(Model.IsActive ? "danger" : "success") w-100">
                                        @if (Model.IsActive)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <line x1="18" y1="6" x2="6" y2="18" />
                                                <line x1="6" y1="6" x2="18" y2="18" />
                                            </svg>
                                            @:停用此方案
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M5 12l5 5l10 -10" />
                                            </svg>
                                            @:啟用此方案
                                        }
                                    </button>
                                </form>
                            </div>
                            <div class="col-md-3">
                                <form method="post" asp-action="TogglePublic" asp-route-id="@Model.PlanId">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-@(Model.IsPublic ? "secondary" : "success") w-100">
                                        @if (Model.IsPublic)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <line x1="3" y1="3" x2="21" y2="21" />
                                                <path d="M10.584 10.587a2 2 0 0 0 2.828 2.83" />
                                                <path d="M9.363 5.365a9.466 9.466 0 0 1 2.637 -.365c4 0 7.333 2.333 10 7c-.778 1.361 -1.612 2.524 -2.503 3.488m-2.14 1.861c-1.631 1.1 -3.415 1.651 -5.357 1.651c-4 0 -7.333 -2.333 -10 -7c1.369 -2.395 2.913 -4.175 4.632 -5.341" />
                                            </svg>
                                            @:設為不公開
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <circle cx="12" cy="12" r="2" />
                                                <path d="M22 12c-2.667 4.667 -6 7 -10 7s-7.333 -2.333 -10 -7c2.667 -4.667 6 -7 10 -7s7.333 2.333 10 7" />
                                            </svg>
                                            @:設為公開
                                        }
                                    </button>
                                </form>
                            </div>
                            <div class="col-md-3">
                                <a asp-action="Edit" asp-route-id="@Model.PlanId" class="btn btn-outline-primary w-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
                                        <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" />
                                        <path d="M16 5l3 3" />
                                    </svg>
                                    編輯方案資訊
                                </a>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <line x1="4" y1="7" x2="20" y2="7" />
                                        <line x1="10" y1="11" x2="10" y2="17" />
                                        <line x1="14" y1="11" x2="14" y2="17" />
                                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                    </svg>
                                    刪除方案
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 刪除確認 Modal -->
<div class="modal modal-blur fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="modal-title">確定要刪除此方案嗎？</div>
                <div>方案名稱：<strong>@Model.PlanName</strong></div>
                <div class="text-muted mt-2">此操作無法復原</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">取消</button>
                <form method="post" asp-action="Delete" asp-route-id="@Model.PlanId" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">確定刪除</button>
                </form>
            </div>
        </div>
    </div>
</div>
