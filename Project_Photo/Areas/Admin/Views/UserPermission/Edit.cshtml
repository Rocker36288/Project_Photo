@using Project_Photo.Areas.Admin.ViewModels.Permission
@model UserPermissionEditViewModel
@{
    ViewData["Title"] = "編輯權限";
}

@section Styles {
    <style>
        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .required::after {
            content: " *";
            color: #d63939;
        }

        .form-text {
            font-size: 0.875rem;
            color: #64748b;
        }

        .readonly-field {
            background-color: #f8f9fa;
            cursor: not-allowed;
        }
    </style>
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    編輯權限
                </h2>
                <div class="text-muted mt-1">@Model.PermissionName (@Model.PermissionCode)</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="Details" asp-route-id="@Model.PermissionId" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M5 12l14 0" />
                            <path d="M5 12l6 6" />
                            <path d="M5 12l6 -6" />
                        </svg>
                        返回詳情
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="PermissionId" />

            <div class="row row-cards">

                <!-- 基本資訊 Card -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">基本資訊</h3>
                        </div>
                        <div class="card-body">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger alert-dismissible" role="alert">
                                    <div class="d-flex">
                                        <div>
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <circle cx="12" cy="12" r="9" />
                                                <line x1="12" y1="8" x2="12" y2="12" />
                                                <line x1="12" y1="16" x2="12.01" y2="16" />
                                            </svg>
                                        </div>
                                        <div>
                                            <h4 class="alert-title">發生錯誤</h4>
                                            <div class="text-muted">
                                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                                </div>
                            }

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="PermissionId" class="form-label">權限ID</label>
                                        <input asp-for="PermissionId" class="form-control readonly-field" readonly />
                                        <small class="form-text">權限ID無法修改</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="PermissionCode" class="form-label required">權限代碼</label>
                                        <input asp-for="PermissionCode" class="form-control" placeholder="例如: USER_VIEW" maxlength="100" />
                                        <small class="form-text">請使用英文大寫和底線，建議格式: XXX_ACTION</small>
                                        <span asp-validation-for="PermissionCode" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PermissionName" class="form-label required">權限名稱</label>
                                <input asp-for="PermissionName" class="form-control" placeholder="例如: 查看用戶" maxlength="100" />
                                <small class="form-text">請輸入權限的中文名稱</small>
                                <span asp-validation-for="PermissionName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PermissionDescription" class="form-label">權限說明</label>
                                <textarea asp-for="PermissionDescription" class="form-control" rows="4" placeholder="請輸入此權限的詳細說明..." maxlength="200"></textarea>
                                <small class="form-text">最多 200 個字元，用於說明此權限的具體功能</small>
                                <span asp-validation-for="PermissionDescription" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 分類與關聯 Card -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">分類與關聯</h3>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="SystemId" class="form-label">所屬系統</label>
                                        <select asp-for="SystemId" class="form-select">
                                            <option value="">請選擇</option>
                                            @if (ViewBag.SystemList != null)
                                            {
                                                @foreach (var system in ViewBag.SystemList)
                                                {
                                                    <option value="@system.SystemId">@system.SystemName</option>
                                                }
                                            }
                                        </select>
                                        <small class="form-text">選擇此權限所屬的系統模組</small>
                                        <span asp-validation-for="SystemId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="CategoryId" class="form-label">權限分類</label>
                                        <select asp-for="CategoryId" class="form-select">
                                            <option value="">請選擇</option>
                                            @if (ViewBag.CategoryList != null)
                                            {
                                                @foreach (var category in ViewBag.CategoryList)
                                                {
                                                    <option value="@category.CategoryId">@category.CategoryName</option>
                                                }
                                            }
                                        </select>
                                        <small class="form-text">選擇此權限所屬的分類</small>
                                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ParentPermissionId" class="form-label">父權限</label>
                                <select asp-for="ParentPermissionId" class="form-select">
                                    <option value="">無（頂層權限）</option>
                                    @if (ViewBag.ParentPermissionList != null)
                                    {
                                        @foreach (var permission in ViewBag.ParentPermissionList)
                                        {
                                            <option value="@permission.PermissionId">@permission.PermissionName</option>
                                        }
                                    }
                                </select>
                                <small class="form-text">如果此權限是某個權限的子權限，請選擇父權限。否則保持空白（頂層權限）</small>
                                <span asp-validation-for="ParentPermissionId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">狀態</label>
                                <div>
                                    <label class="form-check form-check-inline">
                                        <input asp-for="IsActive" class="form-check-input" type="radio" value="true" />
                                        <span class="form-check-label">啟用</span>
                                    </label>
                                    <label class="form-check form-check-inline">
                                        <input asp-for="IsActive" class="form-check-input" type="radio" value="false" />
                                        <span class="form-check-label">停用</span>
                                    </label>
                                </div>
                                <small class="form-text">停用後，此權限將無法被使用</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 提交按鈕 -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-footer text-end">
                            <div class="d-flex">
                                <a asp-action="Details" asp-route-id="@Model.PermissionId" class="btn btn-link">取消</a>
                                <button type="submit" class="btn btn-primary ms-auto">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M6 4h10l4 4v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2" />
                                        <circle cx="12" cy="14" r="2" />
                                        <polyline points="14 4 14 8 8 8 8 4" />
                                    </svg>
                                    儲存變更
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </form>

        <!-- 警告提示 -->
        @if (Model.ChildPermissionCount > 0 || Model.AssignedRoleTypeCount > 0)
        {
            <div class="row row-cards mt-3">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-yellow-lt">
                            <h3 class="card-title">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon me-2 text-yellow" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M12 9v2m0 4v.01" />
                                    <path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" />
                                </svg>
                                編輯注意事項
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @if (Model.ChildPermissionCount > 0)
                                {
                                    <div class="col-md-6">
                                        <h4 class="mb-3 text-yellow">
                                            <i class="ti ti-alert-triangle me-2"></i>
                                            此權限有 @Model.ChildPermissionCount 個子權限
                                        </h4>
                                        <p class="text-muted">
                                            修改此權限的代碼或停用此權限，可能會影響子權限的正常運作。
                                            請謹慎操作！
                                        </p>
                                    </div>
                                }
                                @if (Model.AssignedRoleTypeCount > 0)
                                {
                                    <div class="col-md-6">
                                        <h4 class="mb-3 text-yellow">
                                            <i class="ti ti-alert-triangle me-2"></i>
                                            此權限已分配給 @Model.AssignedRoleTypeCount 個角色
                                        </h4>
                                        <p class="text-muted">
                                            停用此權限後，擁有這些角色的用戶將失去相關功能。
                                            請謹慎操作！
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const permissionCodeInput = document.querySelector('#PermissionCode');
            const parentPermissionSelect = document.querySelector('#ParentPermissionId');
            const isActiveRadios = document.querySelectorAll('input[name="IsActive"]');

            const originalPermissionCode = permissionCodeInput.value;
            const originalParentPermissionId = parentPermissionSelect.value;
            const originalIsActive = document.querySelector('input[name="IsActive"]:checked')?.value === 'true';

            // 權限代碼格式驗證
            if (permissionCodeInput) {
                permissionCodeInput.addEventListener('input', function (e) {
                    // 自動轉換為大寫
                    e.target.value = e.target.value.toUpperCase();

                    // 只允許英文字母、數字和底線
                    e.target.value = e.target.value.replace(/[^A-Z0-9_]/g, '');
                });
            }

            // 表單提交前確認
            form.addEventListener('submit', function (e) {
                const permissionCode = permissionCodeInput.value.trim();
                const parentPermissionId = parentPermissionSelect.value;
                const currentIsActive = document.querySelector('input[name="IsActive"]:checked')?.value === 'true';

                // 如果修改了權限代碼，顯示警告
                if (permissionCode !== originalPermissionCode) {
                    if (!confirm('警告：修改權限代碼可能會影響系統中引用此權限的程式碼。確定要修改嗎？')) {
                        e.preventDefault();
                        return false;
                    }
                }

                // 如果有子權限且要停用，顯示警告
                const hasChildPermissions = @Model.ChildPermissionCount > 0;
                if (hasChildPermissions && originalIsActive && !currentIsActive) {
                    if (!confirm('警告：此權限有 @Model.ChildPermissionCount 個子權限。停用後，子權限可能無法正常運作。確定要停用嗎？')) {
                        e.preventDefault();
                        return false;
                    }
                }

                // 如果有角色使用且要停用，顯示警告
                const hasAssignedRoles = @Model.AssignedRoleTypeCount > 0;
                if (hasAssignedRoles && originalIsActive && !currentIsActive) {
                    if (!confirm('警告：此權限已分配給 @Model.AssignedRoleTypeCount 個角色。停用後，這些角色的用戶將失去相關功能。確定要停用嗎？')) {
                        e.preventDefault();
                        return false;
                    }
                }
            });
        });
    </script>
}
