@using Project_Photo.Areas.Admin.ViewModels.Permission
@model UserPermissionDetailsViewModel
@{
    ViewData["Title"] = "權限詳情";
}

@section Styles {
    <style>
        .info-row {
            padding: 0.75rem 0;
            border-bottom: 1px solid #e6e7e9;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            font-weight: 600;
            color: #1e293b;
            min-width: 120px;
        }

        .info-value {
            color: #475569;
        }

        .related-item {
            padding: 0.75rem;
            border: 1px solid #e6e7e9;
            border-radius: 0.25rem;
            margin-bottom: 0.75rem;
            transition: all 0.2s;
        }

            .related-item:hover {
                background-color: #f8f9fa;
                border-color: #cbd5e1;
            }

        .related-item-header {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .related-item-meta {
            font-size: 0.875rem;
            color: #64748b;
        }
    </style>
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    權限詳情
                </h2>
                <div class="text-muted mt-1">@Model.PermissionName (@Model.PermissionCode)</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="Index" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M5 12l14 0" />
                            <path d="M5 12l6 6" />
                            <path d="M5 12l6 -6" />
                        </svg>
                        返回列表
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.PermissionId" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
                            <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" />
                            <path d="M16 5l3 3" />
                        </svg>
                        編輯
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.PermissionId" class="btn btn-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <line x1="4" y1="7" x2="20" y2="7" />
                            <line x1="10" y1="11" x2="10" y2="17" />
                            <line x1="14" y1="11" x2="14" y2="17" />
                            <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                            <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                        </svg>
                        刪除
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                <div class="d-flex">
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon alert-icon">
                            <path d="M5 12l5 5l10 -10"></path>
                        </svg>
                    </div>
                    <div>@TempData["Success"]</div>
                </div>
                <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
            </div>
        }

        <div class="row row-deck mb-3">
            <!-- 基本資訊 -->
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">基本資訊</h3>
                    </div>
                    <div class="card-body">
                        <div class="info-row d-flex">
                            <div class="info-label">權限ID:</div>
                            <div class="info-value flex-fill">@Model.PermissionId</div>
                        </div>
                        <div class="info-row d-flex">
                            <div class="info-label">權限代碼:</div>
                            <div class="info-value flex-fill">
                                <span class="badge bg-indigo-lt">@Model.PermissionCode</span>
                            </div>
                        </div>
                        <div class="info-row d-flex">
                            <div class="info-label">權限名稱:</div>
                            <div class="info-value flex-fill">
                                <strong>@Model.PermissionName</strong>
                            </div>
                        </div>
                        <div class="info-row d-flex">
                            <div class="info-label">權限說明:</div>
                            <div class="info-value flex-fill">@(Model.PermissionDescription ?? "-")</div>
                        </div>
                        <div class="info-row d-flex">
                            <div class="info-label">所屬系統:</div>
                            <div class="info-value flex-fill">
                                @if (!string.IsNullOrEmpty(Model.SystemName))
                                {
                                    <span class="badge bg-blue-lt">@Model.SystemName</span>
                                }
                                else
                                {
                                    <span class="text-muted">未分配</span>
                                }
                            </div>
                        </div>
                        <div class="info-row d-flex">
                            <div class="info-label">權限分類:</div>
                            <div class="info-value flex-fill">
                                @if (!string.IsNullOrEmpty(Model.CategoryName))
                                {
                                    <span class="badge bg-cyan-lt">@Model.CategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted">未分類</span>
                                }
                            </div>
                        </div>
                        <div class="info-row d-flex">
                            <div class="info-label">父權限:</div>
                            <div class="info-value flex-fill">
                                @if (!string.IsNullOrEmpty(Model.ParentPermissionName))
                                {
                                    <span class="text-muted">@Model.ParentPermissionName</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-lt">頂層權限</span>
                                }
                            </div>
                        </div>
                        <div class="info-row d-flex">
                            <div class="info-label">狀態:</div>
                            <div class="info-value flex-fill">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-green-lt">啟用中</span>
                                }
                                else
                                {
                                    <span class="badge bg-red-lt">已停用</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 統計資訊 -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">統計資訊</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 mb-3">
                                <div class="text-center">
                                    <div class="text-muted mb-2" style="font-size: 1rem;">子權限數</div>
                                    <div class="mb-0">
                                        <span class="badge bg-purple-lt" style="font-size: 2rem; padding: 0.75rem 1.5rem;">@Model.ChildPermissionCount</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="text-center">
                                    <div class="text-muted mb-2" style="font-size: 1rem;">擁有角色數</div>
                                    <div class="mb-0">
                                        <span class="badge bg-orange-lt" style="font-size: 2rem; padding: 0.75rem 1.5rem;">@Model.AssignedRoleTypeCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 子權限列表 -->
        <div class="row row-cards mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">子權限列表 (@Model.ChildPermissionCount)</h3>
                    </div>
                    <div class="card-body" style="max-height: 550px; overflow-y: auto;">
                        @if (Model.ChildPermissions != null && Model.ChildPermissions.Any())
                        {
                            @foreach (var child in Model.ChildPermissions)
                            {
                                <div class="related-item">
                                    <div class="related-item-header d-flex justify-content-between align-items-start">
                                        <div>
                                            <span class="badge bg-indigo-lt me-2">@child.PermissionCode</span>
                                            <strong>@child.PermissionName</strong>
                                        </div>
                                        <div>
                                            @if (child.IsActive)
                                            {
                                                <span class="badge bg-green-lt">啟用</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-red-lt">停用</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(child.PermissionDescription))
                                    {
                                        <div class="text-muted small mb-2">@child.PermissionDescription</div>
                                    }
                                    <div class="related-item-meta">
                                        <i class="ti ti-key me-1"></i>
                                        權限ID: @child.PermissionId
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="ti ti-key-off" style="font-size: 2rem;"></i>
                                <p class="mb-0 mt-2">此權限下沒有子權限</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 擁有此權限的角色列表 -->
        <div class="row row-cards">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">擁有此權限的角色 (@Model.AssignedRoleTypeCount)</h3>
                    </div>
                    <div class="card-body" style="max-height: 550px; overflow-y: auto;">
                        @if (Model.AssignedRoleTypes != null && Model.AssignedRoleTypes.Any())
                        {
                            @foreach (var role in Model.AssignedRoleTypes)
                            {
                                <div class="related-item">
                                    <div class="related-item-header d-flex justify-content-between align-items-start">
                                        <div>
                                            <span class="badge bg-azure-lt me-2">@role.RoleCode</span>
                                            <strong>@role.RoleName</strong>
                                        </div>
                                        <div>
                                            @if (role.IsActive)
                                            {
                                                <span class="badge bg-green-lt">啟用</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-red-lt">停用</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(role.RoleDescription))
                                    {
                                        <div class="text-muted small mb-2">@role.RoleDescription</div>
                                    }
                                    <div class="related-item-meta">
                                        @if (!string.IsNullOrEmpty(role.SystemName))
                                        {
                                            <span class="me-3">
                                                <i class="ti ti-layout-grid me-1"></i>
                                                系統: @role.SystemName
                                            </span>
                                        }
                                        <span>
                                            <i class="ti ti-shield me-1"></i>
                                            角色等級: @role.RoleLevel
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="ti ti-shield-off" style="font-size: 2rem;"></i>
                                <p class="mb-0 mt-2">目前沒有角色擁有此權限</p>
                                <p class="text-muted small">您可以到角色管理頁面為角色分配此權限</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
