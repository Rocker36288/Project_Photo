@model IEnumerable<PhotoQuotaType>

@{
    ViewData["Title"] = "配額類型管理";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">訂閱管理</div>
                <h2 class="page-title">配額類型管理</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <a asp-action="Create" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <path d="M12 5l0 14"></path>
                        <path d="M5 12l14 0"></path>
                    </svg>
                    新增配額類型
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <div class="d-flex">
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M5 12l5 5l10 -10"></path>
                        </svg>
                    </div>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- 統計卡片 -->
        <div class="row row-cards mb-3">
            <div class="col-sm-6 col-lg-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-primary text-white avatar">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"></path>
                                        <path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z"></path>
                                    </svg>
                                </span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">總配額類型數</div>
                                <div class="text-muted">所有配額類型</div>
                            </div>
                            <div class="col-auto">
                                <div class="display-6 text-primary">@ViewBag.TotalCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-success text-white avatar">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <path d="M5 12l5 5l10 -10"></path>
                                    </svg>
                                </span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">啟用配額</div>
                                <div class="text-muted">正在使用中</div>
                            </div>
                            <div class="col-auto">
                                <div class="display-6 text-success">@ViewBag.ActiveCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-secondary text-white avatar">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <path d="M18 6l-12 12"></path>
                                        <path d="M6 6l12 12"></path>
                                    </svg>
                                </span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">停用配額</div>
                                <div class="text-muted">已停用</div>
                            </div>
                            <div class="col-auto">
                                <div class="display-6 text-secondary">@ViewBag.InactiveCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 搜尋與篩選 -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">配額類型列表</h3>
            </div>
            <div class="card-body border-bottom py-3">
                <form asp-action="Index" method="get">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <input type="text" name="searchKeyword" class="form-control" placeholder="搜尋方案名稱或代碼..." value="@ViewBag.SearchKeyword">
                        </div>
                        <div class="col-md-3">
                            <select name="systemId" class="form-select">
                                <option value="">所有系統</option>
                                @foreach (var item in ViewBag.Systems as List<SelectListItem>)
                                {
                                    <option value="@item.Value" selected="@(ViewBag.SystemId?.ToString() == item.Value)">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="isActive" class="form-select">
                                <option value="">所有狀態</option>
                                <option value="true" selected="@(ViewBag.IsActive == true)">啟用</option>
                                <option value="false" selected="@(ViewBag.IsActive == false)">停用</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                    <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                                    <path d="M21 21l-6 -6"></path>
                                </svg>
                                搜尋
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchKeyword) || ViewBag.SystemId != null || ViewBag.IsActive != null)
                    {
                        <div class="mt-2">
                            <a asp-action="Index" class="btn btn-link btn-sm">清除篩選</a>
                        </div>
                    }
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>配額類型代碼</th>
                            <th>配額類型名稱</th>
                            <th>配額單位</th>
                            <th>重置週期</th>
                            <th>所屬系統</th>
                            <th>狀態</th>
                            <th>更新時間</th>
                            <th class="w-1">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-blue-lt">@item.QuotaTypeCode</span>
                                    </td>
                                    <td>@item.QuotaTypeName</td>
                                    <td>
                                        <span class="badge bg-azure-lt">@item.QuotaUnit</span>
                                    </td>
                                    <td>
                                        @switch (item.ResetPeriod)
                                        {
                                            case "Month":
                                                <span class="badge bg-cyan-lt">每月重置</span>
                                                break;
                                            case "Year":
                                                <span class="badge bg-purple-lt">每年重置</span>
                                                break;
                                            case "Never":
                                                <span class="badge bg-secondary-lt">永不重置</span>
                                                break;
                                        }
                                    </td>
                                    <td>@item.System?.SystemName</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <path d="M5 12l5 5l10 -10"></path>
                                                </svg>
                                                啟用
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <path d="M18 6l-12 12"></path>
                                                    <path d="M6 6l12 12"></path>
                                                </svg>
                                                停用
                                            </span>
                                        }
                                    </td>
                                    <td>@item.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <div class="btn-list flex-nowrap">
                                            <a asp-action="Details" asp-route-id="@item.QuotaTypeId" class="btn btn-sm btn-primary">詳細</a>
                                            <a asp-action="Edit" asp-route-id="@item.QuotaTypeId" class="btn btn-sm btn-secondary">編輯</a>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteQuotaType(@item.QuotaTypeId)">刪除</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg mb-3" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"></path>
                                        <path d="M16 3v4"></path>
                                        <path d="M8 3v4"></path>
                                        <path d="M4 11h16"></path>
                                        <path d="M7 14h.01"></path>
                                        <path d="M11 14h.01"></path>
                                        <path d="M15 14h.01"></path>
                                        <path d="M7 17h.01"></path>
                                        <path d="M11 17h.01"></path>
                                        <path d="M15 17h.01"></path>
                                    </svg>
                                    <p>目前沒有配額類型</p>
                                    <a asp-action="Create" class="btn btn-primary">新增第一個配額類型</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteQuotaType(id) {
            if (confirm('確定要刪除此配額類型嗎?')) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                fetch('@Url.Action("Delete", "QuotaType")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${id}&__RequestVerificationToken=${token}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('刪除失敗,請稍後再試');
                });
            }
        }
    </script>

    @Html.AntiForgeryToken()
}
