@model IEnumerable<Project_Photo.Models.Post>

@section Styles
{
    <link href="~/lib/datatables/css/jquery.datatables.min.css" rel="stylesheet" />
}
<div class="container py-5">
    <p>
        <a class="btn btn-outline-primary" asp-action="Create">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-library-plus"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M18.333 2a3.667 3.667 0 0 1 3.667 3.667v8.666a3.667 3.667 0 0 1 -3.667 3.667h-8.666a3.667 3.667 0 0 1 -3.667 -3.667v-8.666a3.667 3.667 0 0 1 3.667 -3.667zm-4.333 4a1 1 0 0 0 -1 1v2h-2a1 1 0 0 0 0 2h2v2a1 1 0 0 0 2 0v-2h2a1 1 0 0 0 0 -2h-2v-2a1 1 0 0 0 -1 -1" /><path d="M3.517 6.391a1 1 0 0 1 .99 1.738c-.313 .178 -.506 .51 -.507 .868v10c0 .548 .452 1 1 1h10c.284 0 .405 -.088 .626 -.486a1 1 0 0 1 1.748 .972c-.546 .98 -1.28 1.514 -2.374 1.514h-10c-1.652 0 -3 -1.348 -3 -3v-10.002a3 3 0 0 1 1.517 -2.605" /></svg>
            新增貼文
        </a>
    </p>
    <div class="card">
        <div class="card-body">
            <table id="table1" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <td>PostId</td>
                        <td>UserId</td>
                        <td>PostType</td>
                        <td>PostTypeId</td>
                        <td>PostContent</td>
                        <td>Status</td>
                        <td>ParentPostId</td>
                        <td class="w-1">新增時間</td>
                        <td class="w-1">修改時間</td>
                        <td class="w-1">刪除時間</td>
                        <td class="w-1"></td>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts
{
    <script src="~/lib/datatables/js/jquery.datatables.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.4.0/js/dataTables.fixedHeader.min.js"></script>
    <script>
        $(document).ready(function(){
            // alert("123");
            $("#table1").dataTable({
                ajax: {
                    type:"GET",
                    url:"/Posts/IndexJson",
                    dataSrc:function(data) {
                        return data;
                    }
                },
                columns: [
                    { data:"postId",  },
                    { data:"userId",  },
                    { data:"postType",  },
                    { data:"postTypeId",  },
                    { data:"postContent",  },
                    { data:"status",  },
                    { data:"parentPostId",  },
                    { data:"createdAt",  },
                    { data:"updatedAt",  },
                    { data:"deletedAt",  },
                    {
                        data: "postId",
                        render: function (data) {
                            return `
                                <a href="/Posts/Details/${data}" title="詳細" class="btn btn-primary btn-sm mb-1" >
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-dots"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><path d="M9 14v.01" /><path d="M12 14v.01" /><path d="M15 14v.01" /></svg>
                                詳細</a>
                                <a href="/Posts/Edit/${data}" title="編輯" class="btn btn-teal btn-sm mb-1" >
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-edit"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" /><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" /><path d="M16 5l3 3" /></svg>
                                編輯</a>
                                <a href="/Posts/Delete/${data}" title="刪除" class="btn btn-danger btn-sm mb-1" >
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-trash-off"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 3l18 18" /><path d="M4 7h3m4 0h9" /><path d="M10 11l0 6" /><path d="M14 14l0 3" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l.077 -.923" /><path d="M18.384 14.373l.616 -7.373" /><path d="M9 5v-1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
                                刪除</a>
                            `;
                        }
                    },
                ],
                fixedHeader:{header:true},  //凍結Header
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.3.5/i18n/zh-HANT.json',
                },
            });
        });
    </script>

}