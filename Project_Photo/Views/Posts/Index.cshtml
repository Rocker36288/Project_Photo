@model IEnumerable<Project_Photo.Models.Post>

@section Styles
{
    <link href="~/lib/datatables/css/jquery.datatables.min.css" rel="stylesheet" />
}
<div class="container py-5">
    <table id="table1" class="table table-striped table-hover">
        <thead>
            <tr>
                <td>操作</td>
                <td>postId</td>
                <td>userId</td>
                <td>postType</td>
                <td>postTypeId</td>
                <td>postContent</td>
                <td>status</td>
                <td>parentPostId</td>
                <td>createdAt</td>
                <td>updatedAt</td>
                <td>deletedAt</td>
            </tr>
        </thead>
    </table>

</div>
@section Scripts
{
    <script src="~/lib/datatables/js/jquery.datatables.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.4.0/js/dataTables.fixedHeader.min.js"></script>
    <script>
        $(document).ready(function(){
            // alert("123");
            $("#table1").dataTable({
                ajax: {
                    type:"GET",
                    url:"/Posts/IndexJson",
                    dataSrc:function(data) {
                        return data;
                    }
                },
                columns: [
                    {
                        data: "postId",
                        render: function (data) {
                            return `
                                <a href="/Posts/Edit/${data}">Edit</a> |
                                <a href="/Posts/Details/${data}">Details</a> |
                                <a href="/Posts/Delete/${data}">Delete</a>
                            `;
                        }
                    },
                    { data:"postId",  },
                    { data:"userId",  },
                    { data:"postType",  },
                    { data:"postTypeId",  },
                    { data:"postContent",  },
                    { data:"status",  },
                    { data:"parentPostId",  },
                    { data:"createdAt",  },
                    { data:"updatedAt",  },
                    { data:"deletedAt",  },
                ],
                fixedHeader:{header:true},  //凍結Header
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.3.5/i18n/zh-HANT.json',
                },
            });
        });
    </script>

}